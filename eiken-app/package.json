{
  "name": "manatobi-eiken",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --mode eiken",
    "build": "node scripts/check-target.mjs && vite build --mode eiken",
    "build:demo": "vite build --mode eiken",
    "build:vercel": "node scripts/check-target.mjs --production && vite build --mode eiken.production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/eiken.test.ts --maxWorkers=1",
    "test:rules": "node --test tests/firestore-rules.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
