rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /eiken_study_progress/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid) && request.resource.data.uid == uid;
   allow delete: if false;
  }
  match /eiken_user_data/{uid} { allow read, create, update: if owner(uid); allow delete: if false; }
  match /eiken_users/{uid} { allow read, create, update: if owner(uid); allow delete: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
