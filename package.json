{
  "name": "webapp",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "pr:create": "node scripts/pr-create.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node smoke-test.mjs",
    "test:media": "node --test scripts/media.test.mjs",
    "test:content": "node scripts/check-content.mjs",
    "media:manifest": "node scripts/export-media-manifest.mjs",
    "media:images": "node scripts/generate-images.mjs",
    "media:audio": "node scripts/generate-audio.mjs",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
